# Change this to the rootURL of your site. Leave blank if you do not have one
ROOT_URL=

# Apache Configuration
APACHE_PORT=8080

# PostgreSQL Configuration
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Passwords for the two application database roles created at init
# smartstate_app is used by the website (subject to row-level security)
# smartstate_engine is used by the Java engine (bypasses row-level security)
APP_DB_PASSWORD=
ENGINE_DB_PASSWORD=

# Admin User EPPN
# (i.e. abc123@uky.edu or user@example.com)
ADMIN_EPPN=

# Java engine (each key is passed to the engine container as HLQ_<key>)
DISABLE_MESSAGING=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VALIDATE_WEBHOOK=true
PUBLIC_BASE_URL=http://localhost:8080
SURVEY_URL=http://localhost:8080/survey/take-survey/
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
CHECKDELAY=5000
CHECKTIMER=30000
